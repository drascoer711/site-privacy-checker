# Public/browser configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-only configuration
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
AUTH_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-key

# Safe admin allowlist. This grants admin API access, not password access.
ADMIN_EMAILS=cerocekro@gmail.com

# Optional Discord webhook for non-sensitive account/admin events.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me
